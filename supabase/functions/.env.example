# Edge Function secrets (local: `supabase functions serve --env-file supabase/functions/.env`; prod: `supabase secrets set`)
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.
DEVICE_JWT_SECRET=            # >= 32 chars random, e.g. `openssl rand -base64 48`
PAIRING_TOKEN_PEPPER=         # >= 32 chars random, different from the above
FCM_SERVICE_ACCOUNT_JSON=     # Firebase service-account JSON (one line); only `commands-dispatch` uses it, never the web or the app
CRON_SECRET=                  # >= 32 chars random; the scheduler sends it in `x-cron-secret` when it calls `commands-dispatch`
ALLOWED_ORIGINS=http://localhost:3000   # comma-separated, exact origins, no wildcard

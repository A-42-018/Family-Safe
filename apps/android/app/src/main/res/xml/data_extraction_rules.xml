<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device through cloud backup or device-to-device transfer. Tokens are wrapped by an
     Android Keystore key that cannot be restored elsewhere anyway; a restored device must re-enroll. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
